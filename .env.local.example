# =================================================================
# Sift 思筛 — 环境变量示例
# 复制本文件为 .env.local,按需填入真实值
# =================================================================

# ─── LLM 配置 (必填) ──────────────────────────────────────────────
# DeepSeek API Key,从 https://platform.deepseek.com 获取
# 用于:简历结构化抽取 + 项目 AI 评估 + JD 三维匹配评分
DEEPSEEK_API_KEY=sk-your-key-here

# 设为 1 时跳过真实 DeepSeek 调用,使用固定 stub 数据
# 适合:测试 / 离线开发 / CI;生产环境必须为 0 或不设
LLM_STUB=0

# ─── 数据库 / 文件存储 (可选,有合理默认) ─────────────────────────
# SQLite 数据库路径
# 本地开发: data/sift.db
# Docker  : /var/lib/sift/data/sift.db
# 测试    : :memory:
# DATABASE_URL=data/sift.db

# PDF 上传文件目录
# UPLOADS_DIR=data/uploads

# ─── 服务监听 (可选) ──────────────────────────────────────────────
# Next.js 服务端口与主机
# PORT=3000
# HOSTNAME=127.0.0.1

# ─── Docker / 自部署 (可选) ───────────────────────────────────────
# 启动时自动跑 Drizzle migrations
# Docker 模式推荐设为 1(首次启动建表);本地开发用 `npm run db:migrate` 即可
# RUN_MIGRATIONS_ON_BOOT=0
